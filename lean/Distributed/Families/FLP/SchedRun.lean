import Distributed.Families.FLP.Scheduler

set_option autoImplicit false

/-! # Distributed.Families.FLP.SchedRun

The infinite run produced by a stage scheduler (`Sched`) and its fairness
properties (FLP 1985, proof of Theorem 1): alive processes take infinitely
many steps, messages to alive processes are eventually received, and every
event after the prefix comes from some stage.
-/

namespace Distributed
namespace FLP
namespace Async

variable {Proc Msg St : Type} [DecidableEq Proc] [DecidableEq Msg]
variable {P : Protocol Proc Msg St}

namespace Sched

variable (S : Sched P)

/-- Refilling preserves a property of all pending events, given stages have it. -/
theorem refill_all (Q : Event Proc Msg → Prop)
    (hQ : ∀ C t, S.Inv C → ∀ e ∈ S.stage C t, Q e) {s : MState Proc Msg St}
    (hs : S.Good s) (h : ∀ e ∈ s.pend, Q e) : ∀ e ∈ (S.refill s).pend, Q e := by
  rcases s with ⟨i, _ | ⟨a, rest⟩, C⟩
  · exact hQ C _ hs.2
  · exact h

/-- Popping only removes pending events. -/
theorem pop_sub (s : MState Proc Msg St) : ∀ e ∈ (S.pop s).pend, e ∈ s.pend := by
  rcases s with ⟨i, _ | ⟨a, rest⟩, C⟩
  · exact fun _ h => h
  · exact fun _ h => List.mem_cons_of_mem _ h

variable (pre : Schedule Proc Msg) (C₀ : Config Proc Msg St)
variable (h0 : Appl P C₀ pre ∧ S.Inv (exec P C₀ pre)) (d : Event Proc Msg)
include h0

/-- After refilling, a tick executes the head of the pending list. -/
theorem tick_spec (k : ℕ) : ∃ e rest, (S.refill (S.states pre C₀ k)).pend = e :: rest ∧
    S.ev pre C₀ d k = e ∧ Applicable (S.states pre C₀ k).cfg e ∧
    (S.states pre C₀ (k + 1)).cfg = apply P (S.states pre C₀ k).cfg e := by
  obtain ⟨hg, hne, hc⟩ := S.refill_good (S.states_good pre C₀ h0 k)
  show ∃ e rest, _ ∧ (S.refill (S.states pre C₀ k)).pend.headD d = e ∧ _ ∧
    (S.pop (S.refill (S.states pre C₀ k))).cfg = _
  rw [← hc]
  generalize S.refill (S.states pre C₀ k) = r at hg hne ⊢
  rcases r with ⟨i, _ | ⟨e, rest⟩, C⟩
  · exact absurd rfl hne
  · exact ⟨e, rest, rfl, rfl, hg.1.1, rfl⟩

/-- The run generated by the scheduler. -/
def toRun : Run P where
  cfg k := (S.states pre C₀ k).cfg
  ev := S.ev pre C₀ d
  valid k := by
    obtain ⟨e, -, -, he, ha, hs⟩ := S.tick_spec pre C₀ h0 d k
    rw [he]
    exact ⟨ha, hs⟩

/-- Boundary configurations satisfy the stage invariant. -/
theorem boundary_inv {k : ℕ} (hk : (S.states pre C₀ k).pend = []) :
    S.Inv (S.states pre C₀ k).cfg := by
  have h := (S.states_good pre C₀ h0 k).2
  rw [hk] at h
  exact h

/-- Every event of a stage started at a boundary is eventually executed. -/
theorem boundary_events {k : ℕ} (hk : (S.states pre C₀ k).pend = []) :
    ∀ e ∈ S.stage (S.states pre C₀ k).cfg (S.tgt (S.states pre C₀ k).idx),
      ∃ j, k ≤ j ∧ S.ev pre C₀ d j = e := by
  intro e he
  obtain ⟨a, rest, hst, hev, hs⟩ := S.tick_of_nil pre C₀ d hk (S.boundary_inv pre C₀ h0 hk)
  rw [hst] at he
  rcases List.mem_cons.1 he with rfl | he
  · exact ⟨k, le_refl k, hev⟩
  · obtain ⟨j, hj, h⟩ := S.pend_events pre C₀ d rest (k + 1) (by rw [hs]) e he
    exact ⟨j, by omega, h⟩

/-- Every stage index is started at some boundary. -/
theorem exists_boundary (i : ℕ) :
    ∃ k, (S.states pre C₀ k).pend = [] ∧ (S.states pre C₀ k).idx = i := by
  induction i with
  | zero =>
    obtain ⟨h1, -, h3⟩ := S.pend_run pre C₀ pre 0 rfl
    exact ⟨0 + pre.length, h1, h3⟩
  | succ i ih =>
    obtain ⟨k, hk, hi⟩ := ih
    obtain ⟨_, rest, -, -, hs⟩ := S.tick_of_nil pre C₀ (S.tgt 0) hk (S.boundary_inv pre C₀ h0 hk)
    obtain ⟨h1, -, h3⟩ := S.pend_run pre C₀ rest (k + 1) (by rw [hs])
    refine ⟨k + 1 + rest.length, h1, ?_⟩
    rw [h3, hs, hi]

/-- Every target is the target of a stage starting arbitrarily late. -/
theorem boundary_target (t : Event Proc Msg) (N : ℕ) :
    ∃ k, N ≤ k ∧ (S.states pre C₀ k).pend = [] ∧ S.tgt (S.states pre C₀ k).idx = t := by
  obtain ⟨i, hi, ht⟩ := S.tgt_inf t N
  obtain ⟨k, hk, hidx⟩ := S.exists_boundary pre C₀ h0 i
  have := S.idx_le pre C₀ k
  exact ⟨k, by omega, hk, by rw [hidx, ht]⟩

/-- A served applicable target is executed at or after any boundary for it. -/
theorem served_after (t : Event Proc Msg) (N : ℕ) (hA : S.Alive t.1)
    (hap : ∀ k, N ≤ k → Applicable (S.states pre C₀ k).cfg t) :
    ∃ j, N ≤ j ∧ S.ev pre C₀ d j = t := by
  obtain ⟨k, hNk, hk, ht⟩ := S.boundary_target pre C₀ h0 t N
  have hI := S.boundary_inv pre C₀ h0 hk
  have hmem := S.serves _ t hI hA (hap k hNk)
  rw [← ht] at hmem
  obtain ⟨j, hj, h⟩ := S.boundary_events pre C₀ h0 d hk _ hmem
  rw [ht] at h
  exact ⟨j, by omega, h⟩

/-- Alive processes are nonfaulty in the generated run. -/
theorem alive_nonFaulty {q : Proc} (hq : S.Alive q) :
    (S.toRun pre C₀ h0 d).NonFaulty q := by
  intro N
  obtain ⟨j, hj, h⟩ := S.served_after pre C₀ h0 d (q, none) N hq (fun _ _ => trivial)
  exact ⟨j, hj, by simp [toRun, h]⟩

/-- Messages addressed to alive processes are eventually received. -/
theorem msg_fair {k : ℕ} {x : Proc × Msg} (hx : x ∈ ((S.toRun pre C₀ h0 d).cfg k).buf)
    (hA : S.Alive x.1) : ∃ j, k ≤ j ∧ (S.toRun pre C₀ h0 d).ev j = (x.1, some x.2) := by
  by_contra hc
  push_neg at hc
  have hp := (S.toRun pre C₀ h0 d).applicable_persist (fun j hj => hc j hj) hx
  obtain ⟨j, hj, h⟩ := S.served_after pre C₀ h0 d (x.1, some x.2) k hA (fun k' hk' => by
    have := hp (k' - k)
    rwa [show k + (k' - k) = k' by omega] at this)
  exact hc j hj h

/-! ## Events After the Prefix -/

/-- After the prefix, all pending events come from stages. -/
theorem pend_after_prefix (Q : Event Proc Msg → Prop)
    (hQ : ∀ C t, S.Inv C → ∀ e ∈ S.stage C t, Q e) :
    ∀ k, pre.length ≤ k → ∀ e ∈ (S.states pre C₀ k).pend, Q e := by
  intro k
  induction k with
  | zero =>
    intro hk e he
    have hp : pre = [] := List.length_eq_zero_iff.1 (Nat.le_zero.1 hk)
    have h0p : (S.states pre C₀ 0).pend = pre := rfl
    rw [h0p, hp] at he
    cases he
  | succ k ih =>
    intro hk e he
    by_cases hlt : pre.length ≤ k
    · have hg := S.states_good pre C₀ h0 k
      exact S.refill_all Q hQ hg (ih hlt) e (S.pop_sub _ e he)
    · obtain ⟨h1, -, -⟩ := S.pend_run pre C₀ pre 0 rfl
      rw [show k + 1 = 0 + pre.length by omega, h1] at he
      cases he

/-- After the prefix, every executed event comes from some stage. -/
theorem ev_after_prefix (Q : Event Proc Msg → Prop)
    (hQ : ∀ C t, S.Inv C → ∀ e ∈ S.stage C t, Q e) {k : ℕ} (hk : pre.length ≤ k) :
    Q (S.ev pre C₀ d k) := by
  obtain ⟨e, rest, hp, he, -⟩ := S.tick_spec pre C₀ h0 d k
  have hall := S.refill_all Q hQ (S.states_good pre C₀ h0 k)
    (S.pend_after_prefix pre C₀ h0 Q hQ k hk)
  rw [he]
  exact hall e (by rw [hp]; exact List.mem_cons_self ..)

/-- The configuration after the prefix is the prefix's execution. -/
theorem cfg_prefix : (S.toRun pre C₀ h0 d).cfg pre.length = exec P C₀ pre := by
  obtain ⟨-, h2, -⟩ := S.pend_run pre C₀ pre 0 rfl
  rw [Nat.zero_add] at h2
  exact h2

end Sched

end Async
end FLP
end Distributed
