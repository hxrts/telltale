import Distributed.Model.ConsensusEnvelope
import Distributed.Model.Simulation

set_option autoImplicit false

/-! # Distributed.Model.ConsensusEnvelopeAdequacy

Observational adequacy for consensus envelopes proved by lockstep simulation,
plus a concrete instance: a reference append-only decision log versus an
implementation that additionally tracks acknowledgement metadata.

`ConsensusEnvelope.adequacy_of_refinement_hypothesis` remains the conditional
form for bundles whose run sets are abstract predicates with no step relation.
-/

/-
The Problem. Consensus adequacy was a restated premise.
Solution Structure. Instantiate `Simulation.LockstepSimulation` with a shared
observation and derive `ObservationalAdequacyModuloEnvelope_consensus` for the
run sets generated by the two step relations.
-/

namespace Distributed
namespace ConsensusEnvelope

open Simulation

universe u v w

/-! ## Generic Adequacy by Simulation -/

/-- Adequacy proved from a lockstep simulation whose relation implies equal
observations: runs of both systems on a common label stream stay in the envelope. -/
theorem adequacy_consensus_of_simulation
    {State : Type u} {Label : Type v} {Obs : Type w}
    {observe : State → Obs}
    {Ref Impl : LabeledSystem State Label}
    (sim : LockstepSimulation Ref Impl observe observe) (labels : Nat → Label) :
    ObservationalAdequacyModuloEnvelope_consensus observe
      (RunOf Ref labels) (RunOf Impl labels) := by
  intro ref impl hRef hImpl n
  exact obs_agree_of_simulation sim hRef hImpl n

/-! ## Concrete Instance: Log with Acknowledgement Metadata -/

/-- State: committed decision log and an acknowledgement counter. -/
abbrev LogState := List Nat × Nat

/-- Safety-visible observation: the committed log only. -/
def logObserve (s : LogState) : List Nat := s.1

/-- Reference system: empty log; each step appends the decided value. -/
def refLogSystem : LabeledSystem LogState Nat where
  init s := s = ([], 0)
  step d s s' := s' = (s.1 ++ [d], 0)

/-- Implementation: also appends, and counts acknowledgements invisibly. -/
def implAckSystem : LabeledSystem LogState Nat where
  init s := s.1 = []
  step d s s' := s' = (s.1 ++ [d], s.2 + 1)

/-- Simulation relation: equal committed logs. -/
def logSimulation : LockstepSimulation refLogSystem implAckSystem logObserve logObserve where
  rel s t := s.1 = t.1
  init := by
    intro s t hs ht
    simp only [refLogSystem] at hs
    subst hs
    exact ht.symm
  step := by
    intro l s s' t t' hRel hs ht
    simp only [refLogSystem, implAckSystem] at hs ht
    subst hs ht
    simp [hRel]
  obs := fun h => h

/-- Concrete adequacy: the acknowledgement-tracking implementation is
observationally adequate for the reference log on every decision stream. -/
theorem log_adequacy (labels : Nat → Nat) :
    ObservationalAdequacyModuloEnvelope_consensus logObserve
      (RunOf refLogSystem labels) (RunOf implAckSystem labels) :=
  adequacy_consensus_of_simulation logSimulation labels

end ConsensusEnvelope
end Distributed
