use flake

# Limit Lake/Lean builds to 3 threads
export LEAN_NUM_THREADS=3

# Reload when the pinned Lean release changes (nix-direnv only watches the flake).
watch_file lean/lean-toolchain

# Machine-local shared Lake artifact cache; absent for other contributors,
# in which case Lake falls back to its default cache location.
if [ -f ../lean-builder/env.sh ]; then
  watch_file ../lean-builder/env.sh
  source ../lean-builder/env.sh
fi
